# ============================================================
# Legacy Docker compatible build
# Single-stage image: apt packages install only once
# ============================================================

FROM python:3.12-slim-bullseye

ENV PYTHONDONTWRITEBYTECODE=1
ENV PYTHONUNBUFFERED=1
ENV PATH="/opt/venv/bin:$PATH"
ENV WKHTMLTOPDF_PATH=/usr/local/bin/wkhtmltopdf

RUN rm -f /etc/apt/apt.conf.d/docker-clean

RUN printf '%s\n' \
    'deb http://archive.debian.org/debian bullseye main' \
    > /etc/apt/sources.list \
    && printf 'Acquire::Check-Valid-Until "false";\n' \
    > /etc/apt/apt.conf.d/99archive

# ============================================================
# System Dependencies
# Installed once only
# ============================================================

# wkhtmltopdf is not in Debian repos for all variants; install upstream .deb
# for pdfkit (payslips / PDF mail attachments).
ARG WKHTMLTOPDF_DEB_URL=https://github.com/wkhtmltopdf/packaging/releases/download/0.12.6.1-3/wkhtmltox_0.12.6.1-3.bullseye_amd64.deb
RUN apt-get update \
    && apt-get install -y --no-install-recommends \
        libpq5 \
        libjpeg62-turbo \
        zlib1g \
        libcairo2 \
        libpango-1.0-0 \
        libgdk-pixbuf-xlib-2.0-0 \
        libxml2 \
        libxslt1.1 \
        libffi7 \
        curl \
        ca-certificates \
        fontconfig \
        fonts-dejavu-core \
        fonts-liberation \
        libx11-6 \
        libxcb1 \
        libxext6 \
        libxrender1 \
        xfonts-75dpi \
        xfonts-base \
        netcat-openbsd \
        gettext \
    && curl -fsSL -o /tmp/wkhtmltox.deb "${WKHTMLTOPDF_DEB_URL}" \
    && dpkg -i /tmp/wkhtmltox.deb \
    && rm -f /tmp/wkhtmltox.deb \
    && apt-get clean \
    && rm -rf /var/lib/apt/lists/*

# ============================================================
# Python Virtual Environment
# ============================================================

RUN python -m venv /opt/venv

WORKDIR /app

COPY requirements.txt /app/requirements.txt

RUN pip install --upgrade pip setuptools wheel \
    && pip install --no-cache-dir -r /app/requirements.txt

# ============================================================
# Application User
# ============================================================

RUN useradd --create-home --uid 1000 appuser

# ============================================================
# Application
# ============================================================

COPY . /app

# ============================================================
# Compile Translation Files
# ============================================================

RUN find . -name '*.po' \
    -execdir sh -c 'msgfmt "$1" -o "${1%.po}.mo"' _ {} \;

# ============================================================
# Entrypoint
# ============================================================

COPY docker/entrypoint.sh /entrypoint.sh

# ============================================================
# Permissions
# ============================================================

RUN chmod +x /entrypoint.sh \
    && mkdir -p /app/staticfiles /app/media \
    && chown -R appuser:appuser /app \
    && chown appuser:appuser /entrypoint.sh \
    && chown -R appuser:appuser /opt/venv

# ============================================================
# Run as non-root
# ============================================================

USER appuser

# ============================================================
# Application Port
# ============================================================

EXPOSE 8000

# ============================================================
# Health Check
# ============================================================

HEALTHCHECK --interval=30s --timeout=30s --retries=3 \
    CMD curl -f http://localhost:8000/health/ || exit 1

# ============================================================
# Start Application
# ============================================================

ENTRYPOINT ["/entrypoint.sh"]

CMD ["gunicorn", "horilla.wsgi:application", "--config", "docker/gunicorn.conf.py"]
